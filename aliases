alias grep="grep --color=auto"
alias fgrep="fgrep --color=auto"
alias egrep="egrep --color=auto"

alias listenports="lsof -nP -iTCP -sTCP:LISTEN"

alias rcat="find . -type f 2>/dev/null -exec printf '\033[1;33m' \; -exec printf {} \; -exec printf '\033[0m\n' \; -exec echo '=======================' \; -exec cat {} \; -exec echo '' \;"

[[ -f "$HOME/.aliases.local" ]] && . "$HOME/.aliases.local"
