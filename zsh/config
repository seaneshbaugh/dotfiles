autoload -U compinit && compinit -u

autoload -U colors && colors

fpath=($DOTFILES_DIRECTORY/zsh/functions $fpath)
autoload -U $DOTFILES_DIRECTORY/zsh/functions/*

REPORTTIME=30

[ -z "$HISTFILE" ] && HISTFILE="$HOME/.zsh_history"

HISTSIZE=500000
SAVEHIST=100000

setopt EXTENDED_HISTORY
setopt HIST_EXPIRE_DUPS_FIRST
setopt HIST_IGNORE_DUPS
setopt HIST_VERIFY
setopt SHARE_HISTORY

if [[ -f "/usr/share/git-core/contrib/completion/git-prompt.sh" ]]; then
    . "/usr/share/git-core/contrib/completion/git-prompt.sh"
elif [[ -f "/usr/lib/git-core/git-sh-prompt" ]]; then
    . "/usr/lib/git-core/git-sh-prompt"
elif [[ -f "/Library/Developer/CommandLineTools/usr/share/git-core/git-prompt.sh" ]]; then
    . "/Library/Developer/CommandLineTools/usr/share/git-core/git-prompt.sh"
fi

GIT_PS1_SHOWCOLORHINTS=1

setopt PROMPT_SUBST

PS1='%{$fg[cyan]%}%n%{$reset_color%} %{$fg[yellow]%}%~%{$reset_color%}% $(__git_ps1 "[%s]") %# '

precmd () {
       print -Pn "\e]2; %~/ \a"
}

preexec () {
        print -Pn "\e]2; %~/ \a"
}

command -v mise > /dev/null 2>& 1 && eval "$(mise activate zsh)"
