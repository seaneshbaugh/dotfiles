export PATH="$HOME/bin:$PATH"

# TODO: Remove this once all machines are migrated from asdf to mise.
[[ -d "${ASDF_DATA_DIR:=$HOME/.asdf}/shims" ]] && export PATH="${ASDF_DATA_DIR:=$HOME/.asdf}/shims:$PATH"

# Add mise to PATH.
[[ -d "$HOME/.local/bin" ]] && export PATH="$HOME/.local/bin:$PATH"

# Add GNAT compiler for Ada to PATH.
[[ -d "$HOME/opt/GNAT/2020/bin" ]] && export PATH="$PATH:$HOME/opt/GNAT/2020/bin"

# Add rustc and cargo to PATH.
[[ -d "$HOME/.cargo/bin" ]] && export PATH="$HOME/.cargo/bin:$PATH"

# Add uv for Python to PATH.
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

export EDITOR="emacs"
